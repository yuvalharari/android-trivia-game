<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Settings"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:layout_marginBottom="24dp"/>

            <!-- Category selector for general quizzes -->
            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category:"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Number of questions slider -->
            <TextView
                android:id="@+id/tvNumQuestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Number of Questions: 5"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <SeekBar
                android:id="@+id/seekBarQuestions"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Timer toggle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timer:"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable Timer"
                android:textColor="#FFFFFF"
                android:checked="true"
                android:layout_marginBottom="24dp"/>

            <!-- Show correct answer option -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Answer Options:"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/checkBoxShowAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show correct answer"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFFFFF"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Start Game"
                android:textColor="#29B6F6"
                android:backgroundTint="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnBackToMenu"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Back to Menu"
                android:textColor="#29B6F6"
                android:backgroundTint="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>